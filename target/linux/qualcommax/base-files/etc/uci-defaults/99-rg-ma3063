#!/bin/sh
# RG-MA3063 first-boot defaults: WiFi on, maintainer watermark.
# Runs on all qualcommax boards but only acts on ruijie,rg-ma3063.
[ "$(board_name)" = "ruijie,rg-ma3063" ] || exit 0

# 1. WiFi enabled by default with explicit SAFE settings
# (fresh installs ship with radios disabled; relying on bare
# 'wifi config' defaults once left a DFS/160MHz combo that hung
# the QCN6122 on reload, so pin conservative values here).
wifi config 2>/dev/null
for R in radio0 radio1; do
	uci -q get wireless.$R >/dev/null || continue
	uci set wireless.$R.country='ID'
	case "$(uci -q get wireless.$R.band)" in
		2g)	uci set wireless.$R.channel='6'
			uci set wireless.$R.htmode='HE20' ;;
		5g)	uci set wireless.$R.channel='36'
			uci set wireless.$R.htmode='HE80' ;;
	esac
	uci -q delete wireless.$R.disabled
done
uci -q delete wireless.default_radio0.disabled
uci -q delete wireless.default_radio1.disabled
uci commit wireless

# 2. SSH login banner watermark (shown by dropbear on every login).
grep -q "github.com/REITZG1" /etc/banner 2>/dev/null || cat >> /etc/banner <<'EOF'

RG-MA3063 build maintained by REITZG1 <https://github.com/REITZG1>
EOF

# 3. LuCI footer watermark (bootstrap theme, subtle text link).
for F in $(find /usr/share/ucode/luci/template /www -name 'footer.ut' 2>/dev/null); do
	grep -q "github.com/REITZG1" "$F" 2>/dev/null || \
	sed -i 's|</span>| / Maintained by <a href="https://github.com/REITZG1" target="_blank" rel="noreferrer">REITZG1</a></span>|' "$F"
done

exit 0
